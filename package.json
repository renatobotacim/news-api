{
  "name": "news-api",
  "version": "1.0.0",
  "description": "API REST somente leitura (GET) para o projeto Minha Prefeitura, multi-tenant via MySQL.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "db:setup": "npm run migrate && npm run seed"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "api",
    "express",
    "mysql",
    "swagger",
    "multi-tenant"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.5",
    "swagger-ui-express": "^5.0.1"
  }
}
